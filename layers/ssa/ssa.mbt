///|
/// A variable in SSA form. Each variable is assigned exactly once, and may be
/// used multiple times. Variables are identified by a unique `id` that is
/// generated by the `Program`'s `_id_gen` field.
#valtype
pub(all) struct Var {
  id : Id
} derive(Eq, Compare, Hash)

///|
/// A mutable cell in SSA form. Cells are used for variables that must be
/// captured by inner functions or mutated across basic blocks. Like `Var`, each
/// cell is identified by a unique `id` generated by the `Program`'s `_id_gen`
/// field. Cells are not directly assigned to; instead, they are updated through
/// `StoreCellS` statements, and their current value is read through `CellE`
/// expressions.
///
/// The special "environment cell" with `id == -1` is used to model accesses to
/// the global environment. It is used to represent global variable accesses and
/// upvalue accesses to the global environment.
#valtype
pub(all) struct Cell {
  id : Id
} derive(Eq, Compare, Hash)

///|
pub(all) enum Multi {
  VarargM
  CallM(Call)
} derive(Debug)

///|
pub(all) enum Call {
  NormalC(Expr, Array[Expr], Multi?)
  MethodC(Expr, String, Array[Expr], Multi?)
} derive(Debug)

///|
pub(all) enum TableInit {
  EmptyTI
  ArrayTI(Array[Expr], Multi?)
  TableTI(Array[(Expr, Expr)])
} derive(Debug)

///|
pub(all) enum Expr {
  ConstE(Constant)
  VarE(Var)
  CellE(Cell)
  /// Numeric-for continuation test. It returns whether `ctrl` is still within
  /// the loop range described by `limit` and `step`, including the sign-based
  /// choice between ascending and descending comparisons.
  NumericForCheckE(Expr, Expr, Expr)
  IndexE(Expr, Expr)
  TableE(TableInit)
  UnaryE(UnaryOp, Expr)
  BinaryE(BinaryOp, Expr, Expr)
  AndE(Expr, Expr)
  OrE(Expr, Expr)
  CallE(Call)
  ClosureE(FuncId, Array[Var])
} derive(Debug)

///|
#valtype
pub(all) struct Label {
  id : Id
  /// Block parameters encode phi semantics for merge points and loop headers.
  params : Array[Var]
}

///|
pub(all) struct Target(Label, Array[Expr]) derive(Debug)

///|
pub(all) enum Stmt {
  BindS(Var, Expr)
  StoreCellS(Cell, Expr)
  SetIndexS(Expr, Expr, Expr)
  BindMultiS(Array[Var], Multi)
  SetListS(Expr, Expr, Array[Expr], Multi?)
} derive(Debug)

///|
/// SSA merge points are expressed with block parameters.
/// Predecessor edges provide the corresponding arguments through `Target.args`.
/// The CFG is intentionally canonicalized to generic branches instead of
/// preserving bytecode-specific control-flow opcodes.
pub(all) enum Term {
  JumpT(Target)
  CondT(Expr, Target, Target)
  ReturnT(Array[Expr], Multi?)
} derive(Debug)

///|
pub(all) struct Block {
  stmts : Array[Stmt]
  term : Term
} derive(Debug)

///|
pub(all) struct Func {
  index : Int
  /// Function parameters are kept at the function boundary instead of being
  /// modeled as entry block parameters.
  params : Array[Var]
  /// Captured variables are not defined in the function itself, but are instead
  /// captured from outer scopes and accessed through `VarE` expressions. They
  /// are listed here for bookkeeping purposes, and to facilitate capture
  /// conversion in later stages.
  capture_vars : Array[Var]
  /// Captured cells reuse the shared storage cells from outer scopes.
  capture_cells : Array[Cell]
  /// Cells allocated by this function for locals that must live in shared
  /// mutable storage.
  cells : Array[Cell]
  vararg : Bool
  blocks : SortedMap[Label, Block]
  entry : Label
} derive(Debug)

///|
pub(all) struct Program {
  _id_gen : IdGen
  funcs : Array[Func]
  main : FuncId
} derive(Debug)

///|
pub fn Cell::env() -> Cell {
  { id: Id(-1), }
}

///|
pub fn Cell::is_env(self : Cell) -> Bool {
  self.id.0 == -1
}

///|
pub impl Debug for Var with fn to_repr(self) {
  Repr::literal("v\{self.id.0}")
}

///|
pub impl Debug for Cell with fn to_repr(self) {
  if self.id.0 == -1 {
    Repr::literal("_ENV")
  } else {
    Repr::literal("c\{self.id.0}")
  }
}

///|
pub impl Debug for Label with fn to_repr(self) {
  Repr::literal("B\{self.id.0}")
}

///|
pub impl Eq for Label with fn equal(self, other) {
  self.id == other.id
}

///|
pub impl Compare for Label with fn compare(self, other) {
  Id::compare(self.id, other.id)
}

///|
pub impl Hash for Label with fn hash_combine(self, hasher) {
  Id::hash_combine(self.id, hasher)
}
